---
import Site from '../layouts/Site.astro';
import { sitePath } from '../lib/site-path';
---
<Site locale="en" title="Page not found | PDFEditGo" description="This page could not be found. Return to the free browser-local PDF tools.">
  <div class="legal">
    <h1>Page not found</h1>
    <p>The address may have changed. Choose a PDF tool to start a new task.</p>
    <a class="button primary" href={sitePath('/')}>Open PDF tools</a>
  </div>
</Site>
