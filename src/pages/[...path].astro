---
import Site from '../layouts/Site.astro';
import ToolCards from '../components/ToolCards.astro';
import Workspace from '../components/Workspace.astro';
import AdSlot from '../components/AdSlot.astro';
import { locales, tools, getText, localePath, toolContent, legalContent, type Locale, type Tool } from '../lib/i18n';
export function getStaticPaths() {
  const legal=['about','privacy','terms','contact'] as const;
  return locales.flatMap(locale => [
    {params:{path:locale==='en'?undefined:locale},props:{locale,route:'',tool:'merge-pdf',legal:undefined}},
    ...tools.map(tool=>({params:{path:localePath(locale,tool).replace(/^\/|\/$/g,'')},props:{locale,route:tool,tool,legal:undefined}})),
    ...legal.map(slug=>({params:{path:localePath(locale,slug).replace(/^\/|\/$/g,'')},props:{locale,route:slug,tool:undefined,legal:slug}})),
  ]);
}
interface Props { locale:Locale; route:string; tool?:Tool; legal?:'about'|'privacy'|'terms'|'contact'; }
const {locale,route,tool,legal}=Astro.props;
const d=getText(locale);
const content=tool?toolContent(locale,tool):undefined;
const info=legal?legalContent(locale,legal,!!import.meta.env.CONTACT_EMAIL):undefined;
const title=info?.title || (route?content!.title:`${d.heroTitle} | PDF Room`);
const description=info?.description || content!.description;
const contactEmail=import.meta.env.CONTACT_EMAIL;
---
<Site locale={locale} title={title} description={description} route={route} application={!!tool}>
  {tool && content ? <>
    <div class="hero">
      <span class="badge">{d.freeBadge}</span>
      <h1>{route?content.heading:d.heroTitle}</h1>
      <p class="subtitle">{route?content.intro:d.heroSubtitle}</p>
    </div>
    <div class="tool-shell">
      <ToolCards locale={locale} selected={tool}/>
      <Workspace locale={locale} tool={tool}/>
      <AdSlot placement="below-tool"/>
    </div>
    <article class="content-section">
      <h2>{d.howTo}</h2>
      <ol class="steps">{content.steps.map(step=><li>{step}</li>)}</ol>
      <h2>{d.features}</h2>
      <ul class="feature-list">{content.features.map(feature=><li>{feature}</li>)}</ul>
      <h2>{d.faq}</h2>
      {content.faqs.map(faq=><details class="faq-item"><summary>{faq.q}</summary><p>{faq.a}</p></details>)}
      <h2>{d.relatedTools}</h2>
      <nav class="related" aria-label={d.relatedTools}>{tools.filter(t=>t!==tool).map(t=><a href={localePath(locale,t)}>{d.tools[t].name}</a>)}</nav>
    </article>
  </> : info ? <article class="legal">
    <h1>{info.title}</h1>
    {info.paragraphs.map(paragraph=><p>{paragraph}</p>)}
    {legal==='contact' && contactEmail && <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>}
  </article>:null}
</Site>
