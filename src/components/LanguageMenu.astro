---
import { getText, locales, localePath, type Locale } from '../lib/i18n';
import { sitePath } from '../lib/site-path';
import '../styles/language-menu.css';

interface Props { locale: Locale; route?: string; }
const { locale, route = '' } = Astro.props;
const d = getText(locale);
const names: Record<Locale, string> = { en: 'English', ko: '한국어', es: 'Español', ja: '日本語' };
---
<details id="language-menu" class="language-menu">
  <summary class="language-trigger" lang="en" aria-controls="language-options">
    <span>Language</span>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </summary>
  <nav id="language-options" class="language-options" aria-label={d.language}>
    {locales.map(lang => <a href={`${sitePath(localePath(lang, route))}${lang==='en'&&!route?'?lang=en':''}`} data-locale={lang} lang={lang} hreflang={lang} aria-current={lang === locale ? 'true' : undefined}>
      <span>{names[lang]}</span>
      {lang === locale && <span class="language-check" aria-hidden="true">✓</span>}
    </a>)}
  </nav>
</details>
