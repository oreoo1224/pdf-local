# Current production origin. Use https:// with no trailing path.
SITE_URL=https://pdfeditgo.com

# The connected custom domain serves this site from its root.
# The Pages workflow reads the configured origin/base path automatically.
SITE_BASE=/

# Current public support address. Never put a secret here.
# Forks and new operators must replace this address with their own.
CONTACT_EMAIL=kgeon1451@gmail.com

# Optional real Google Search Console HTML-tag verification value (not a DNS token).
PUBLIC_GOOGLE_SITE_VERIFICATION=
