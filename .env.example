# Set the production origin before publishing. Use https:// with no trailing path.
# Replace with your actual Cloudflare Pages, GitHub Pages, or custom domain origin.
SITE_URL=

# Use / for a domain-root deployment (Cloudflare Pages default).
# A GitHub project site needs /pdf-local/; the Pages workflow supplies it automatically.
SITE_BASE=/

# A real operator support address. Never put a secret here; this is public.
# Configure before making the website available to the public.
CONTACT_EMAIL=

